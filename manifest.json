{
  "manifest_version": 2,
  "name": "Media Snatcher",
  "version": "0.18.0",
  "description": "ページ内の動画URLを検出してダウンロードする",

  "browser_specific_settings": {
    "gecko": {
      "id": "media-snatcher@local",
      "strict_min_version": "91.0"
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "nativeMessaging",
    "<all_urls>"
  ],

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "Media Snatcher",
    "default_badge_background_color": "#5f4dbc"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
