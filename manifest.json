{
  "manifest_version": 2,
  "name": "MimicVault",
  "version": "0.19.2",
  "description": "ページ内の動画URLを検出してダウンロードする",

  "browser_specific_settings": {
    "gecko": {
      "id": "mimicvault@local",
      "strict_min_version": "91.0"
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "nativeMessaging",
    "bookmarks",
    "<all_urls>"
  ],

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "browser_action": {
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "MimicVault（クリックでパネルを開閉）",
    "default_badge_background_color": "#5f4dbc"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/mediaDetect.js",
        "content/thumbnail.js",
        "content/observe.js",
        "content/sidePanel.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    "popup/*"
  ],

  "background": {
    "scripts": [
      "background/constants.js",
      "background/ismToDashUrl.js",
      "background/mp4BoxWriter.js",
      "background/mssInitSegment.js",
      "background/mssManifestParse.js",
      "background/settings.js",
      "background/domainFilter.js",
      "background/filename.js",
      "background/mediaStore.js",
      "background/mediaHelpers.js",
      "background/urlHelpers.js",
      "background/segmentGroups.js",
      "background/webRequest.js",
      "background/hlsMasterParse.js",
      "background/hlsMediaParse.js",
      "background/hlsCrypto.js",
      "background/hlsDownload.js",
      "background/liveRecording.js",
      "background/liveSegments.js",
      "background/fetchDashInfo.js",
      "background/parseMpd.js",
      "background/dashSegments.js",
      "background/downloadDashTrack.js",
      "background/downloadDashAndMux.js",
      "background/downloadDirectRanged.js",
      "background/autoDashMux.js",
      "background/companion.js",
      "background/companionHls.js",
      "background/downloadSegmentGroup.js",
      "background/mediaMeta.js",
      "background/bookmarkDownload.js",
      "background/messageRouter.js",
      "background/tabs.js"
    ],
    "persistent": false
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
