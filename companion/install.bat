@echo off
:: MimicVault companion app - Windows installer
:: All real work is delegated to PowerShell below.
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "& { $ErrorActionPreference='Stop'; $scriptDir = Split-Path -Parent '%~f0'; $exePath = Join-Path $scriptDir 'mimic-vault.exe'; $batPath = Join-Path $scriptDir 'mimic-vault.bat'; if (Test-Path $exePath) { $wrapperPath = $exePath } elseif (Test-Path $batPath) { $wrapperPath = $batPath } else { Write-Host '[ERROR] Neither mimic-vault.exe nor mimic-vault.bat found.'; exit 1 }; $manifestTemplate = Join-Path $scriptDir 'native-manifest.json'; Write-Host '=== MimicVault companion app installer (Windows) ==='; Write-Host \"companion dir: $scriptDir\"; Write-Host \"host: $wrapperPath\"; if (-not (Get-Command ffmpeg -ErrorAction SilentlyContinue) -and -not (Test-Path (Join-Path $scriptDir 'ffmpeg.exe'))) { Write-Host '[WARN] ffmpeg not found (neither bundled ffmpeg.exe nor on PATH). HLS->MP4 conversion will fail.' } else { Write-Host '[OK] ffmpeg: found' }; $manifestDir = Join-Path $env:APPDATA 'mimic_vault'; New-Item -ItemType Directory -Force -Path $manifestDir | Out-Null; $manifestDest = Join-Path $manifestDir 'native-manifest.json'; $obj = [ordered]@{ name = 'mimic_vault'; description = 'MimicVault companion app - FFmpeg integration'; path = $wrapperPath; type = 'stdio'; allowed_extensions = @('mimicvault@local') }; $msJson = $obj | ConvertTo-Json; [System.IO.File]::WriteAllText($manifestDest, $msJson, (New-Object System.Text.UTF8Encoding($false))); Write-Host \"[OK] Manifest placed: $manifestDest\"; $regPath = 'HKCU:\Software\Mozilla\NativeMessagingHosts\mimic_vault'; New-Item -Path $regPath -Force | Out-Null; Set-ItemProperty -Path $regPath -Name '(default)' -Value $manifestDest; Write-Host '[OK] Registry registered.'; Write-Host ''; Write-Host '=== Installation complete ==='; Write-Host \"Manifest: $manifestDest\"; Write-Host ''; Write-Host 'Restart Firefox to enable the companion indicator in the extension popup.' }"

REM pause
