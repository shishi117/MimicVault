><mxCell id="edf-live_23" value="session削除" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l19" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-bookmark" name="9.ブックマーク一括DL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2088" pageHeight="3238" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::ブックマーク一括DL" value="ブックマーク一括DL データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2068" height="3218" as="geometry"/></mxCell><mxCell id="b0" value="選択したブックマークの一括ダウンロード要求&lt;br&gt;一括DL要求（DOWNLOAD_BOOKMARKS{ids[]}）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="295" y="50" width="1477" height="101" as="geometry"/></mxCell><mxCell id="b1" value="指定されたブックマークの一括ダウンロードを開始する&lt;br&gt;ブックマーク一括DL処理（downloadBookmarks(ids)）&lt;br&gt;bookmarkDownload.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="390" y="181" width="1288" height="105" as="geometry"/></mxCell><mxCell id="b2" value="ブックマークIDからブックマーク情報を取得する&lt;br&gt;ブックマーク情報取得処理（browser.bookmarks.get(id) → node）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="215" y="316" width="1638" height="78" as="geometry"/></mxCell><mxCell id="b3" value="1件のブックマークに対する処理を行う&lt;br&gt;ブックマーク単体処理（processOneBookmark(node)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="390" y="424" width="1288" height="78" as="geometry"/></mxCell><mxCell id="b4" value="ブックマーク先のページを裏タブで開く&lt;br&gt;裏タブでのページ表示処理（browser.tabs.create(node.url,active:false)）&lt;br&gt;→ tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="40" y="532" width="1988" height="105" as="geometry"/></mxCell><mxCell id="b5" value="ページの読み込み完了を待つ&lt;br&gt;タブ読み込み完了待ち処理（waitTabComplete(tab.id)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="372" y="667" width="1323" height="78" as="geometry"/></mxCell><mxCell id="b6" value="自動再生されない動画を再生させるための操作を行う&lt;br&gt;自動再生ナッジ処理（nudgePlay(tabId)）&lt;br&gt;executeScript(自動再生ナッジ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="547" y="775" width="973" height="105" as="geometry"/></mxCell><mxCell id="b7" value="メディアが検出されるまで待機する&lt;br&gt;メディア検出待ち処理（waitForMedia(tabId)）&lt;br&gt;ポーリング→getStore(tabId)参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="477" y="910" width="1113" height="105" as="geometry"/></mxCell><mxCell id="b9" value="検出されたメディアの中から対象を選ぶ&lt;br&gt;メディア選択処理（pickMediaItem(items)）&lt;br&gt;(ストリーミング優先→サイズ最大)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="495" y="1180" width="1078" height="105" as="geometry"/></mxCell><mxCell id="b10" value="対象となるメディアが見つかったかを判定する&lt;br&gt;メディア発見判定（item見つかった?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="462" y="1315" width="1144" height="133" as="geometry"/></mxCell><mxCell id="b12" value="ブックマークのタイトルから保存用ファイル名を決める&lt;br&gt;ファイル名上書き値生成処理&lt;br&gt;stemOverride = bookmarkFilenameStem(タイトル)&lt;br&gt;(getPageTitle併用)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="302" y="1613" width="1463" height="132" as="geometry"/></mxCell><mxCell id="b13" value="検出したメディアのダウンロードを実行する&lt;br&gt;検出メディアDL処理（downloadDetected(item,emit,stemOverride)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="110" y="1775" width="1848" height="78" as="geometry"/></mxCell><mxCell id="b14" value="検出したメディアがHLS/DASH形式かを判定する&lt;br&gt;配信方式判定（isHls/isDash?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="356" y="1883" width="1356" height="133" as="geometry"/></mxCell><mxCell id="b16" value="直接ファイルの場合はそのままダウンロードする&lt;br&gt;直接ファイルDL処理&lt;br&gt;browser.downloads.download(url,filename)&lt;br&gt;→ pollRowProgress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="320" y="2181" width="1428" height="132" as="geometry"/></mxCell><mxCell id="b17" value="ダウンロード完了をポーリングで待つ&lt;br&gt;ダウンロード完了待ち処理（gateDownloadResult）&lt;br&gt;(awaitDownloadComplete)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="460" y="2343" width="1148" height="105" as="geometry"/></mxCell><mxCell id="b18" value="ダウンロードが成功したかを判定する&lt;br&gt;成否判定（dlResult.ok?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="541" y="2478" width="985" height="133" as="geometry"/></mxCell><mxCell id="b21" value="開いた裏タブを閉じ、結果を集計する&lt;br&gt;タブクローズ・結果集約処理（tab.remove(tab.id)）&lt;br&gt;→ results[]へ集約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="442" y="2911" width="1183" height="105" as="geometry"/></mxCell><mxCell id="b8" value="検出済みメディアをタブ単位で保持するストア&lt;br&gt;タブ別メディア一覧（tabMediaStore）&lt;br&gt;(判定・共通ヘルパー図と共通)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="600" y="1045" width="868" height="105" as="geometry"/></mxCell><mxCell id="b11" value="対象メディアが見つからなかったことを通知する&lt;br&gt;失敗通知処理（emit(&#x27;failed&#x27;,{reason:&#x27;no_media&#x27;})）&lt;br&gt;→ bookmarkProgressState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="285" y="1478" width="1498" height="105" as="geometry"/></mxCell><mxCell id="b15" value="HLS/DASH形式の場合は各専用処理に委譲する&lt;br&gt;方式別DLへの委譲（downloadHlsSegments / autoDashMux）&lt;br&gt;→ HLS図/DASH図へ委譲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#d5e8d4;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="250" y="2046" width="1568" height="105" as="geometry"/></mxCell><mxCell id="b19" value="ダウンロード完了後、ブックマークを完了フォルダへ移動する&lt;br&gt;完了フォルダ移動処理（ensureDownloadedFolder(node.parentId)）&lt;br&gt;→ bookmarks.move(bookmarkId,parentId)&lt;br&gt;emit(&#x27;done&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="162" y="2641" width="1743" height="132" as="geometry"/></mxCell><mxCell id="b20" value="ダウンロード失敗を通知する&lt;br&gt;失敗通知処理（emit(&#x27;failed&#x27;,{reason})）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="477" y="2803" width="1113" height="78" as="geometry"/></mxCell><mxCell id="b22" value="各ブックマークの処理状況を保持するストア&lt;br&gt;ブックマークDL進捗状態（bookmarkProgressState）&lt;br&gt;(Map&lt;bookmarkId,{state,...}&gt;)&lt;br&gt;→ BOOKMARK_DL_PROGRESS → popup" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="407" y="3046" width="1253" height="132" as="geometry"/></mxCell><mxCell id="edf-bookmark_1" value="ids[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_2" value="id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;e