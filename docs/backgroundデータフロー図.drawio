l dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1471" pageHeight="2822" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::収集ストリーム" value="収集ストリーム データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1451" height="2802" as="geometry"/></mxCell><mxCell id="s0" value="動画の部品っぽいアドレスが通信にあることに気づく&lt;br&gt;検知URL（webRequest検出 url）&lt;br&gt;(handleNetworkResponse / messageRouter)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="187" y="50" width="1077" height="136" as="geometry"/></mxCell><mxCell id="s1" value="このアドレスが、動画の部品かどうかを調べる&lt;br&gt;セグメントURL判定処理（isSegmentUrl(url)?）&lt;br&gt;segmentGroups.js" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="155" y="216" width="1141" height="179" as="geometry"/></mxCell><mxCell id="s2" value="見つけた動画の部品のアドレスを記録する&lt;br&gt;セグメント記録処理（recordSegment(tabId,url,pageURL)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="268" y="425" width="914" height="78" as="geometry"/></mxCell><mxCell id="s3" value="アドレスから、仲間分けするための名前を作る&lt;br&gt;ディレクトリ名抽出処理（_segDirname(url) → dir）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="315" y="533" width="821" height="78" as="geometry"/></mxCell><mxCell id="s5" value="アドレスが「準備データ」の形と一致するか調べる&lt;br&gt;初期化セグメント判定（INIT_SEG_REに一致?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="116" y="776" width="1218" height="133" as="geometry"/></mxCell><mxCell id="s6" value="「準備データ」のアドレスを、仲間のグループに記録する&lt;br&gt;初期化セグメント登録&lt;br&gt;g.init = url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="284" y="939" width="882" height="105" as="geometry"/></mxCell><mxCell id="s7" value="動画の部品のアドレスを、仲間のグループに追加する&lt;br&gt;メディアセグメント登録&lt;br&gt;g.media.set(url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="316" y="1074" width="818" height="105" as="geometry"/></mxCell><mxCell id="s8" value="部品の数が十分に集まり、まだ登録していないかを調べる&lt;br&gt;登録可否判定&lt;br&gt;media.size &gt;= SEG_MIN(6)&lt;br&gt;&amp;&amp; !_hasManifest(tabId)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="40" y="1209" width="1371" height="225" as="geometry"/></mxCell><mxCell id="s10" value="「この部品グループをダウンロードして」というお願い&lt;br&gt;セグメントグループDL要求（DOWNLOAD_SEGMENT_GROUP）&lt;br&gt;{groupKey,tabId}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="165" y="1626" width="1120" height="136" as="geometry"/></mxCell><mxCell id="s11" value="指定された部品グループのダウンロードを始める&lt;br&gt;セグメントグループDL処理（downloadSegmentGroup({groupKey,tabId})）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="172" y="1792" width="1106" height="78" as="geometry"/></mxCell><mxCell id="s4" value="タブごとに、動画の部品を仲間分けしてためておく場所&lt;br&gt;タブ別セグメントグループ（_segStore[tabId]）&lt;br&gt;(dir別グループ: {media:Map, init, ...})" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="300" y="641" width="850" height="105" as="geometry"/></mxCell><mxCell id="s9" value="仲間分けした部品を、1つの動画としてリストに登録する&lt;br&gt;セグメントグループ登録処理（storeItem生成(groupKey=dir)）&lt;br&gt;→ addToStore(tabId,storeItem)&lt;br&gt;→ 判定・共通ヘルパー図へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="244" y="1464" width="962" height="132" as="geometry"/></mxCell><mxCell id="s12" value="部品グループに入っているアドレスの一覧を取ってくる&lt;br&gt;セグメントグループURL取得処理（getSegmentGroupUrls(tabId,groupKey)）&lt;br&gt;→ {init,media[],pageURL,stem}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="156" y="1900" width="1138" height="105" as="geometry"/></mxCell><mxCell id="s13" value="準備データと部品を同時に取ってきて、つなげる&lt;br&gt;セグメント並列取得・結合処理（urls=[init,...media] を並列fetch(4)）&lt;br&gt;→ ArrayBuffer[] → combine → Uint8Array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="164" y="2035" width="1122" height="105" as="geometry"/></mxCell><mxCell id="s14" value="お手伝いアプリにつながっているか確認する&lt;br&gt;companion接続判定（companion接続中?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="193" y="2170" width="1064" height="133" as="geometry"/></mxCell><mxCell id="s16" value="つなげたデータを、1つのファイルとして保存する&lt;br&gt;ファイル保存処理（Blob(ts/mp4) → browser.downloads.download）&lt;br&gt;→ downloadId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="211" y="2522" width="1029" height="105" as="geometry"/></mxCell><mxCell id="s17" value="部品グループのダウンロードが終わったときの結果&lt;br&gt;ダウンロード結果&lt;br&gt;{ok:true,muxed,filePath/downloadId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="332" y="2657" width="786" height="105" as="geometry"/></mxCell><mxCell id="s15" value="お手伝いアプリに「動画の入れものを作り直して」とお願いする&lt;br&gt;companionへのリマックス依頼&lt;br&gt;base64化 → sendToCompanion(&lt;br&gt;{type:&#x27;remux&#x27;,inputB64,outputName})&lt;br&gt;→ companion連携図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#e6e6e6;" vertex="1" parent="cat::収集ストリーム"><mxGeometry x="236" y="2333" width="978" height="159" as="geometry"/></mxCell><mxCell id="edf-seggroup_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::収集ストリーム" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-seggroup_2" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::収集ストリーム" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/