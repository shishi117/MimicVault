groundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d4" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_9" value="url更新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d5" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d7" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d8" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d9" target="d10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_13" value="true(両方)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d10" target="d11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_14" value="false(片方のみ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d10" target="d12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d12" target="d13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d13" target="d14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d14" target="d15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_18" value="Blob" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d15" target="d16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_19" value="companion接続時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d11" target="d17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_20" value="companion未接続時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d11" target="d21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_21" value="video/audio各1回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d21" target="d12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_22" value="Blob×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d17" target="d18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_23" value="base64×2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d18" target="d19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_24" value="filePath" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d19" target="d20"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-mss" name="5.MSS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1266" pageHeight="2623" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::MSS" value="MSS データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1246" height="2603" as="geometry"/></mxCell><mxCell id="m0" value="ほかの処理から渡される、別方式のアドレス&lt;br&gt;入力データ（url(.ism/Manifest 形状)）&lt;br&gt;← DASH図/webRequest.js から" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="171" y="50" width="904" height="136" as="geometry"/></mxCell><mxCell id="m1" value="アドレスや種類から、この配信方式かどうかを調べる&lt;br&gt;MSS形式判定処理（isMssUrl(url,mimeHint)）&lt;br&gt;ismToDashUrl.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="214" y="216" width="818" height="105" as="geometry"/></mxCell><mxCell id="m2" value="このアドレスから、変換できそうなアドレスの候補をいくつか作る&lt;br&gt;DASH候補URL生成処理（ismToDashCandidates(url)）&lt;br&gt;→ [候補URL×3(Unified/MS-Azure/Wowza記法)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="118" y="351" width="1010" height="105" as="geometry"/></mxCell><mxCell id="m3" value="作った候補のアドレスを、1つずつ試してみる&lt;br&gt;候補URL確認処理（候補を順にfetch）&lt;br&gt;(resolveMssDashUrl / DASH図から)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="270" y="486" width="706" height="105" as="geometry"/></mxCell><mxCell id="m4" value="試した結果に、設計図の目印があるかを調べる&lt;br&gt;MPD候補判定（textに&#x27;&lt;MPD&#x27;を含む候補がある?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="40" y="621" width="1166" height="133" as="geometry"/></mxCell><mxCell id="m6" value="この方式の設計図を取ってきて、中身を読み解く&lt;br&gt;ismマニフェスト取得・解析処理（fetchTextWithReferer(元ism url)）&lt;br&gt;→ parseIsmManifest(text,url)&lt;br&gt;mssManifestParse.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="86" y="919" width="1074" height="132" as="geometry"/></mxCell><mxCell id="m7" value="設計図を読み解いてわかった、映像や音の情報ぜんぶ&lt;br&gt;ismマニフェスト解析結果&lt;br&gt;{ok,videoReps[],audioReps[],mpdDuration}&lt;br&gt;各segInfo={type:&#x27;mss&#x27;,codecPrivateData,&lt;br&gt; chunks[],urlTemplate}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="214" y="1081" width="818" height="159" as="geometry"/></mxCell><mxCell id="m8" value="部品の型から、実際のアドレスの一覧を作る&lt;br&gt;セグメントURL展開処理（expandSegmentUrls(segInfo,...)）&lt;br&gt;dashSegments.js (DASH図と共通)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="158" y="1270" width="930" height="105" as="geometry"/></mxCell><mxCell id="m15" value="この方式ならではの部品の型から、実際のアドレスを作る&lt;br&gt;MSSフラグメントURL展開処理（expandMssFragmentUrls(segInfo)）&lt;br&gt;chunks[]+urlTemplateを展開&lt;br&gt;({bitrate}/{start time}を置換)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="118" y="2296" width="1010" height="132" as="geometry"/></mxCell><mxCell id="m16" value="作り出した、動画の部品アドレスの一覧&lt;br&gt;フラグメントURL一覧（segUrls[]）&lt;br&gt;→ DASH図のdownloadDashTrack等へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#dae8fc;" vertex="1" parent="cat::MSS"><mxGeometry x="310" y="2458" width="626" height="105" as="geometry"/></mxCell><mxCell id="m5" value="変換できるアドレスが決まったので、別の処理に合流する&lt;br&gt;DASH URL確定&lt;br&gt;dashUrl確定 → DASH図のparseMpdへ合流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#dae8fc;" vertex="1" parent="cat::MSS"><mxGeometry x="182" y="784" width="882" height="105" as="geometry"/></mxCell><mxCell id="m9" value="この方式の動画を再生するための「準備データ」を作る&lt;br&gt;MSS初期化セグメント生成処理（buildMssInitSegment(track)）&lt;br&gt;mssInitSegment.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="142" y="1405" width="962" height="105" as="geometry"/></mxCell><mxCell id="m10" value="映像の圧縮方式の情報を読み解いて、必要な数値を取り出す&lt;br&gt;AVCコーデック情報解析処理（parseAvcCodecPrivateData(hex)）&lt;br&gt;→ splitAnnexBNals → {sps,pps}&lt;br&gt;(映像/H264の場合)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="134" y="1540" width="978" height="132" as="geometry"/></mxCell><mxCell id="m11" value="読み解いた情報から、動画の部品の型を組み立てる&lt;br&gt;サンプルエントリ生成処理（buildAvcC(sps,pps) → buildAvc1SampleEntry）&lt;br&gt;mp4BoxWriter.js経由&lt;br&gt;(音声/AACはbuildEsds→buildMp4aSampleEntry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="44" y="1702" width="1157" height="132" as="geometry"/></mxCell><mxCell id="m12" value="映像や音の情報から、動画ファイルの管理部分を組み立てる&lt;br&gt;トラックボックス生成処理（buildTrak(kind,sampleEntryBox,...)）&lt;br&gt;→ moov(mvhd+trak+mvex) + ftyp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="102" y="1864" width="1042" height="105" as="geometry"/></mxCell><mxCell id="m13" value="作った部品の大きさが正しいか、自分で確かめる&lt;br&gt;ボックスサイズ検証処理（assertTopLevelBoxSizes(result)）&lt;br&gt;(自己チェック)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::MSS"><mxGeometry x="150" y="1999" width="946" height="105" as="geometry"/></mxCell><mxCell id="m14" value="作った「準備データ」を、そのままほかの処理に渡す&lt;br&gt;初期化セグメントデータ（initBytes(ArrayBuffer)）&lt;br&gt;→ DASH図のdownloadDashTrack等が&lt;br&gt;fetchせずそのまま使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#dae8fc;" vertex="1" parent="cat::MSS"><mxGeometry x="214" y="2134" width="818" height="132" as="geometry"/></mxCell><mxCell id="edf-mss_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::MSS" source="m0" target="m1"><mxGeometr