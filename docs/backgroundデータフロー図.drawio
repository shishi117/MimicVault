="b10" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_13" value="stemOverride" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b12" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b13" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_15" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b14" target="b15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_16" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b14" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_17" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b15" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b17" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_20" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b18" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_21" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b18" target="b20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b19" target="b21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b20" target="b21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_24" value="emit進捗" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b13" target="b22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_25" value="emit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b11" target="b22"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-companion" name="10.companion連携"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1782" pageHeight="2822" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::companion連携" value="companion連携 データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1762" height="2802" as="geometry"/></mxCell><mxCell id="c0" value="拡張機能が起動したときや設定を変えたときに、お手伝いアプリにつながろうとする&lt;br&gt;companion接続処理（connectCompanion()）&lt;br&gt;起動時 / settingsCache.companionEnabled変化&lt;br&gt;companion.js" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="40" y="50" width="1682" height="171" as="geometry"/></mxCell><mxCell id="c1" value="お手伝いアプリを使わない設定になっていないかを調べる&lt;br&gt;companion有効判定（companionEnabled===false?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="195" y="251" width="1371" height="133" as="geometry"/></mxCell><mxCell id="c3" value="パソコンの中のお手伝いアプリに、直接つながる&lt;br&gt;companionネイティブ接続処理&lt;br&gt;browser.runtime.connectNative(&#x27;mimic_vault&#x27;)&lt;br&gt;→ companionPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="504" y="549" width="754" height="132" as="geometry"/></mxCell><mxCell id="c5" value="いろいろなダウンロード処理から、お手伝いアプリにお願いをする&lt;br&gt;companionへの処理依頼&lt;br&gt;各DL関数(HLS/DASH/直接DL/収集ストリーム)&lt;br&gt;→ sendToCompanion(command,onProgress)&lt;br&gt;{type:&#x27;convert&#x27;|&#x27;mux&#x27;|&#x27;remux&#x27;|&#x27;concatParts&#x27;,...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="376" y="846" width="1010" height="159" as="geometry"/></mxCell><mxCell id="c6" value="お願いごとに番号をつけて、返事待ちリストに登録する&lt;br&gt;リクエストID発行処理（requestId発行）&lt;br&gt;companionPendingRequests.set(id,{resolve,reject,onProgress})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="376" y="1035" width="1010" height="105" as="geometry"/></mxCell><mxCell id="c8" value="お手伝いアプリに、お願いの中身を送る&lt;br&gt;companionへのメッセージ送信処理&lt;br&gt;companionPort.postMessage(&lt;br&gt;{...command,requestId})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="568" y="1305" width="626" height="132" as="geometry"/></mxCell><mxCell id="c9" value="実際に動画を作り直したりつなげたりしてくれる、別のアプリ&lt;br&gt;companionアプリ（Node.js + FFmpeg, 別プロセス）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="408" y="1467" width="946" height="78" as="geometry"/></mxCell><mxCell id="c10" value="お手伝いアプリからの返事を受け取る&lt;br&gt;companion応答受信処理（companionPort.onMessage(msg)）&lt;br&gt;{requestId, type:&#x27;progress&#x27;|ok:true|ok:false}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="432" y="1575" width="898" height="105" as="geometry"/></mxCell><mxCell id="c16" value="お手伝いアプリとのつながりが切れたことに気づき、片づけをする&lt;br&gt;companion切断処理（companionPort.onDisconnect）&lt;br&gt;→ companionPort=null&lt;br&gt;status=&#x27;error&#x27;/&#x27;disconnected&#x27;&lt;br&gt;全pendingRequestsをreject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="376" y="2468" width="1010" height="159" as="geometry"/></mxCell><mxCell id="c17" value="お手伝いアプリとつながっているかどうかを、画面に知らせる&lt;br&gt;companion状態通知処理（broadcastCompanionStatus()）&lt;br&gt;→ COMPANION_STATUS → popup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="408" y="2657" width="946" height="105" as="geometry"/></mxCell><mxCell id="c2" value="お手伝いアプリを使わない設定だと、画面に知らせる&lt;br&gt;無効状態通知&lt;br&gt;status=&#x27;disabled&#x27; → broadcastCompanionStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="472" y="414" width="818" height="105" as="geometry"/></mxCell><mxCell id="c4" value="お手伝いアプリとやり取りするための、通り道&lt;br&gt;companion通信ポート（companionPort）&lt;br&gt;(Native Messagingポート, 変数)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="520" y="711" width="722" height="105" as="geometry"/></mxCell><mxCell id="c7" value="返事待ちのお願いを、ためて管理しておく場所&lt;br&gt;companion応答待ちリクエスト一覧（companionPendingRequests）&lt;br&gt;(Map&lt;requestId,{resolve,reject,onProgress}&gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="384" y="1170" width="994" height="105" as="geometry"/></mxCell><mxCell id="c11" value="届いた返事が「進み具合のお知らせ」かどうかを調べる&lt;br&gt;進捗通知判定（msg.type===&#x27;progress&#x27;?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="221" y="1710" width="1320" height="133" as="geometry"/></mxCell><mxCell id="c13" value="届いた返事が「うまくいった」という内容かを調べる&lt;br&gt;成否判定（msg.ok===true?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="246" y="2008" width="1269" height="133" as="geometry"/></mxCell><mxCell id="c12" value="進み具合の情報を、お願いした人に伝える&lt;br&gt;進捗中継処理（req.onProgress(msg)）&lt;br&gt;→ popupへ進捗通知(各図参照)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="552" y="1873" width="658" height="105" as="geometry"/></mxCell><mxCell id="c14" value="「うまくいった」という結果を、お願いした処理に伝える&lt;br&gt;成功時解決処理（req.resolve(msg)）&lt;br&gt;→ 呼び出し元のPromiseが解決&lt;br&gt;(filePath等)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="440" y="2171" width="882" height="132" as="geometry"/></mxCell><mxCell id="c15" value="「失敗した」という結果を、お願いした処理に伝える&lt;br&gt;失敗時解決処理（req.reject(Error)）&lt;br&gt;→ 呼び出し元のPromiseが失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="472" y="2333" width="818" height="105" as="geometry"/></mxCell><mxCell id="edf-companion_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::companion連携" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-companion_2" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::companion連携" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-companion_3" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opac