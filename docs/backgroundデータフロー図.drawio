rget="r_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-routing_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ルーティング／検出エントリ" source="r_c1" target="r_c2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-helpers" name="2.判定・共通ヘルパー"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2088" pageHeight="4377" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::判定・共通ヘルパー" value="判定・共通ヘルパー データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2068" height="4357" as="geometry"/></mxCell><mxCell id="h_a0" value="メディア種別判定に必要な入力&lt;br&gt;入力データ（url, mimeHint）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="670" y="50" width="728" height="78" as="geometry"/></mxCell><mxCell id="h_a1" value="URLやMIMEからHLS/DASH/TS形式かを判定する&lt;br&gt;メディア種別判定関数群（isHlsUrl / isDashUrl / isTsUrl）&lt;br&gt;mediaTypeDetect.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="267" y="158" width="1533" height="105" as="geometry"/></mxCell><mxCell id="h_a2" value="HLSまたはDASH配信かどうかを判定する&lt;br&gt;ストリーミング判定（isHlsOrDashUrl(url,mimeHint)）&lt;br&gt;= isHlsUrl || isDashUrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="337" y="293" width="1393" height="105" as="geometry"/></mxCell><mxCell id="h_a3" value="判定結果を各処理で利用できるよう返す&lt;br&gt;判定結果（boolean）&lt;br&gt;→ webRequest/mediaStore/mediaMeta/bookmarkDL 等で利用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="162" y="428" width="1743" height="105" as="geometry"/></mxCell><mxCell id="h_d0" value="拡張機能の設定を保存するストレージ&lt;br&gt;設定保存領域（browser.storage.local）&lt;br&gt;(ms_settings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="512" y="2048" width="1043" height="105" as="geometry"/></mxCell><mxCell id="h_d1" value="保存済み設定を読み込み・変更を監視する&lt;br&gt;設定読み込み処理（loadSettings() / storage.onChanged）&lt;br&gt;settings.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="250" y="2183" width="1568" height="105" as="geometry"/></mxCell><mxCell id="h_d3" value="companion連携設定の変更時にポート接続を切り替える&lt;br&gt;companion接続切替処理（connectCompanion()/disconnect()）&lt;br&gt;→ companion連携図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#e6e6e6;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="180" y="2453" width="1708" height="105" as="geometry"/></mxCell><mxCell id="h_f0" value="メディアのメタ情報取得に必要な入力&lt;br&gt;入力データ（url, mimeHint, pageURL）&lt;br&gt;(GET_MEDIA_META)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="383" y="3101" width="1301" height="136" as="geometry"/></mxCell><mxCell id="h_f1" value="メディアの再生時間やサイズなどのメタ情報を取得する&lt;br&gt;メディアメタ情報取得処理（getMediaMeta(url,mimeHint,pageURL)）&lt;br&gt;mediaMeta.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="180" y="3267" width="1708" height="105" as="geometry"/></mxCell><mxCell id="h_f2" value="配信方式に応じてメタ情報取得方法を切り替える&lt;br&gt;メタ情報取得の分岐&lt;br&gt;DASH: fetchDashInfo→{videoReps,audioReps}&lt;br&gt;HLS: fetchHlsVariants+fetch mediaPlaylist&lt;br&gt;→parseMediaPlaylist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#dae8fc;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="302" y="3402" width="1463" height="159" as="geometry"/></mxCell><mxCell id="h_f3" value="取得したメタ情報をポップアップ表示用に返す&lt;br&gt;メタ情報取得結果&lt;br&gt;{ok,method,durationSec,sizeBytes,estimated}&lt;br&gt;→ popup表示用メタ情報" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="267" y="3591" width="1533" height="132" as="geometry"/></mxCell><mxCell id="h_b0" value="ファイル名推定に必要な入力&lt;br&gt;入力データ（url, tabId）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="722" y="563" width="623" height="78" as="geometry"/></mxCell><mxCell id="h_b1" value="URLとページタイトルからファイル名の元となる文字列を取得する&lt;br&gt;ファイル名素材取得処理（inferStem(url) / getPageTitle(tabId)）&lt;br&gt;urlHelpers.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="162" y="671" width="1743" height="105" as="geometry"/></mxCell><mxCell id="h_b2" value="ページタイトルとURL由来の文字列を結合する&lt;br&gt;ファイル名タイトル生成処理（inferTitleStem(url,tabId)）&lt;br&gt;= title + &#x27; &#x27; + urlStem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="320" y="806" width="1428" height="105" as="geometry"/></mxCell><mxCell id="h_b4" value="設定されたテンプレートに沿ってファイル名を組み立てる&lt;br&gt;ファイル名テンプレート適用処理（applyFilenameTemplate(stem,ext)）&lt;br&gt;filename.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="180" y="1049" width="1708" height="105" as="geometry"/></mxCell><mxCell id="h_b5" value="ファイル名から使用できない文字を取り除く&lt;br&gt;ファイル名サニタイズ処理（sanitizeFilename(s)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="442" y="1184" width="1183" height="78" as="geometry"/></mxCell><mxCell id="h_b6" value="保存時に使用する最終的なファイル名&lt;br&gt;生成されたファイル名文字列&lt;br&gt;(例: &#x27;動画タイトル 1080p.mp4&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="617" y="1292" width="833" height="105" as="geometry"/></mxCell><mxCell id="h_d2" value="読み込んだ設定をメモリ上に保持するキャッシュ&lt;br&gt;設定キャッシュ（settingsCache）&lt;br&gt;(メモリ上の設定キャッシュ)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="635" y="2318" width="798" height="105" as="geometry"/></mxCell><mxCell id="h_g0" value="MP4ボックス組み立てに使う入力値&lt;br&gt;入力データ（数値 / 文字列 / バイト列）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="635" y="3753" width="798" height="78" as="geometry"/></mxCell><mxCell id="h_g1" value="数値やFourCCをバイト列に変換する基本関数群&lt;br&gt;バイト列変換ユーティリティ（u8/u16be/u32be/fourcc）&lt;br&gt;mp4BoxWriter.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="390" y="3861" width="1288" height="105" as="geometry"/></mxCell><mxCell id="h_g2" value="複数のバイト列を1つに連結する&lt;br&gt;バイト列結合処理（concatBytes(parts)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="530" y="3996" width="1008" height="78" as="geometry"/></mxCell><mxCell id="h_g3" value="MP4のボックス構造（ヘッダー+データ）を組み立てる&lt;br&gt;MP4ボックス生成処理（box(type,...) / fullBox(type,ver,flags,...)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="40" y="4104" width="1988" height="78" as="geometry"/></mxCell><mxCell id="h_g4" value="組み立てたボックスをMSS初期化セグメント生成に渡す&lt;br&gt;ISO BMFFボックス（Uint8Array）&lt;br&gt;→ mssInitSegment.js 等で利用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="565" y="4212" width="938" height="105" as="geometry"/></mxCell><mxCell id="h_b3" value="ファイル名テンプレート適用時に参照する設定値&lt;br&gt;ファイル名テンプレート設定（settingsCache.filenameTemplate）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::判定・共通ヘルパー"><mxGeometry x="232" y="941" width="1603" height="78" as="geometry"/></mxCell><mxCell id="h_e0" v