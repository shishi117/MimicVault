dgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::判定・共通ヘルパー" source="h_g0" target="h_g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-helpers_24" value="バイト列断片" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::判定・共通ヘルパー" source="h_g1" target="h_g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-helpers_25" value="連結バイト列" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::判定・共通ヘルパー" source="h_g2" target="h_g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-helpers_26" value="size+type+payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::判定・共通ヘルパー" source="h_g3" target="h_g4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-hls" name="3.HLS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1625" pageHeight="4051" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::HLS" value="HLS データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1605" height="4031" as="geometry"/></mxCell><mxCell id="hl0" value="画面から「この動画をダウンロードして」とお願いが届く&lt;br&gt;HLSセグメントDL要求（popup/panel → DOWNLOAD_HLS_SEGMENTS）&lt;br&gt;{url(mediaPlaylistUrl), pageURL, tabId}&lt;br&gt;(ブックマークDL経由はstemOverride付き)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="154" y="50" width="1297" height="171" as="geometry"/></mxCell><mxCell id="hl1" value="細切れ配信の動画を、ダウンロードし始める&lt;br&gt;HLSセグメントDL処理（downloadHlsSegments(...)）&lt;br&gt;→ downloadHlsSegmentsInner(...)&lt;br&gt;hlsDownload.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="401" y="251" width="802" height="132" as="geometry"/></mxCell><mxCell id="hl2" value="お手伝いアプリにつながっているか確認する&lt;br&gt;companion接続判定（companion接続中?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="270" y="413" width="1064" height="133" as="geometry"/></mxCell><mxCell id="hl7" value="動画の一覧表（設計図）を取ってくる&lt;br&gt;プレイリスト取得処理（fetch(mediaPlaylistUrl)）&lt;br&gt;[Referer: pendingReferers]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="401" y="1116" width="802" height="105" as="geometry"/></mxCell><mxCell id="hl8" value="取ってきた動画の一覧表の中身&lt;br&gt;プレイリストテキスト（m3u8）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="553" y="1251" width="498" height="78" as="geometry"/></mxCell><mxCell id="hl9" value="取ってきた一覧表が、画質を選ぶための目次かどうかを調べる&lt;br&gt;マスタープレイリスト判定（isMasterPlaylist(text)?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="65" y="1359" width="1474" height="133" as="geometry"/></mxCell><mxCell id="hl11" value="一覧表を読み解いて、動画の部品の情報を取り出す&lt;br&gt;メディアプレイリスト解析処理（parseMediaPlaylist(text,url)）&lt;br&gt;hlsMediaParse.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="297" y="1657" width="1010" height="105" as="geometry"/></mxCell><mxCell id="hl12" value="読み解いてわかった、動画の部品についての情報ぜんぶ&lt;br&gt;プレイリスト解析結果&lt;br&gt;{keyInfo,mediaSequence,segments[],&lt;br&gt; ended,initUri,totalDuration}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="377" y="1792" width="850" height="132" as="geometry"/></mxCell><mxCell id="hl13" value="配信がもう終わっているか、まだライブ中かを調べる&lt;br&gt;配信終了判定（ended===false（ライブ配信）?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="168" y="1954" width="1269" height="133" as="geometry"/></mxCell><mxCell id="hl15" value="動画の部品にカギ（暗号）がかかっているか調べる&lt;br&gt;暗号化方式判定（keyInfo.method===&#x27;AES-128&#x27;?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="193" y="2252" width="1218" height="133" as="geometry"/></mxCell><mxCell id="hl17" value="動画を再生するための「準備データ」が必要か確認する&lt;br&gt;初期化セグメント有無確認（initUri?）&lt;br&gt;(fMP4初期化セグメント)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="142" y="2550" width="1320" height="179" as="geometry"/></mxCell><mxCell id="hl19" value="動画の部品を、いくつも同時に取ってくる&lt;br&gt;セグメント並列取得処理（segments[]を並列fetch(最大4並列)）&lt;br&gt;→ raw ArrayBuffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="313" y="2867" width="978" height="105" as="geometry"/></mxCell><mxCell id="hl20" value="取ってきた部品にカギがかかっていたら、カギを開ける&lt;br&gt;セグメント復号処理（decryptSegment(raw,key,iv,...)?）&lt;br&gt;AES-128-CBC復号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="353" y="3002" width="898" height="105" as="geometry"/></mxCell><mxCell id="hl21" value="カギを開け終わった、動画の部品のあつまり&lt;br&gt;復号後セグメントデータ（buffers[]）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="457" y="3137" width="690" height="78" as="geometry"/></mxCell><mxCell id="hl22" value="準備データと動画の部品をつなげて、1本の動画ファイルにする&lt;br&gt;セグメント結合処理（combine(initBuffer+buffers)）&lt;br&gt;→ Uint8Array → Blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="321" y="3245" width="962" height="105" as="geometry"/></mxCell><mxCell id="hl23" value="できあがった動画ファイルを、パソコンに保存する&lt;br&gt;ファイル保存処理（browser.downloads.download(blobUrl)）&lt;br&gt;→ downloadId → awaitDownloadComplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="337" y="3380" width="930" height="105" as="geometry"/></mxCell><mxCell id="hl26" value="動画のダウンロードが終わったときの結果&lt;br&gt;ダウンロード結果&lt;br&gt;{ok:true,downloadId,filePath,&lt;br&gt; remuxError?,fallbackExt}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="473" y="3859" width="658" height="132" as="geometry"/></mxCell><mxCell id="hl3" value="お手伝いアプリを使って、動画をダウンロードし作り直す&lt;br&gt;companion経由HLS取得処理（downloadHlsViaCompanion(url,pageURL,...)）&lt;br&gt;{playlistUrl,referer,userAgent,outputName}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="233" y="576" width="1138" height="105" as="geometry"/></mxCell><mxCell id="hl4" value="お手伝いアプリに「作り直して」とお願いする&lt;br&gt;companionへの変換依頼（sendToCompanion({type:&#x27;convert&#x27;,...})）&lt;br&gt;→ companion連携図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#e6e6e6;" vertex="1" parent="cat::HLS"><mxGeometry x="281" y="711" width="1042" height="105" as="geometry"/></mxCell><mxCell id="hl5" value="実際に動画を作り直してくれる、別のアプリ&lt;br&gt;companionアプリ（FFmpeg）&lt;br&gt;Native Messaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="457" y="846" width="690" height="105" as="geometry"/></mxCell><mxCell id="hl6" value="お手伝いアプリが作り直し終えた結果&lt;br&gt;変換結果&lt;br&gt;{ok:true, filePath}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="505" y="981" width="594" height="105" as="geometry"/></mxCell><mxCell id="hl10" value="画質を選ぶための目次だけだったので、ダウンロードできないという結果&lt;br&gt;エラー結果&lt;br&gt;{ok:false,error:&#x27;master_playlist&#x27;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="249" y="1522" width="1106" height="105" as="geometry"/></mxCell><mxCell id="hl14" value="ライブ配信だとわかったら、録画のしかたに切りかえる&lt;br&gt;ライブ録画開始処理（startLiveRecording(...)）&lt;br&gt;→ ライブ録画図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#cce5ff;" vertex="1" parent="cat::HLS"><mxGeometry x="377" y="2117" width="850" height="105" as="geometry"/></mxCell><mxCell id="hl16" value="カギのかかった部品を開けるための、カギを取ってくる&lt;br&gt;復号鍵取得処理（fetchAesKey(uri,pageURL)）&lt;br&gt;hlsCrypto.js → CryptoKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="377" y="2415" width="850" height="105" as="geometry"/></mxCell><mxCell id="hl18" value="動画を再生するための「準備データ」を取ってくる&lt;br&gt;初期化セグメント取得処理（fetch(initUri) → initBuffer(ArrayBuffer)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="232" y="2759" width="1141" height="78" as="geometry"/></mxCell><mxCell id="hl24" value="お手伝いアプリにつながっていて、作り直しができるか確認する&lt;br&gt;companion接続・リマックス判定（companion接続中(remux)?）&lt;br&gt;downloads.search→inputPath" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::HLS"><mxGeometry x="40" y="3515" width="1525" height="179" as="geometry"/></mxCell><mxCell id="hl25" value="お手伝いアプリに「動画の入れものを作り直して」とお願いする&lt;br&gt;companionへのリマックス依頼（sendToCompanion({type:&#x27;remux&#x27;, inputPath,outputName})）&lt;br&gt;→ companion連携図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#e6e6e6;" vertex="1" parent="cat::HLS"><mxGeometry x="105" y="3724" width="1394" height="105" as="geometry"/></mxCell><mxCell id="edf-hls_1" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl2" target="hl3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_2" value="command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl3" target="hl4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_3" value="postMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl4" target="hl5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_4" value="progress/結果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl5" target="hl4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_5" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl4" target="hl6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_6" value="mediaPlaylistUrl,pageURL,tabId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl0" target="hl1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl1" target="hl2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_8" value="false/失敗時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl2" target="hl7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl7" target="hl8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl8" target="hl9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_11" value="true(master)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl9" target="hl10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_12" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl9" target="hl11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl11" target="hl12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl12" target="hl13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_15" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl13" target="hl14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_16" value="false(VOD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl13" target="hl15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_17" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl15" target="hl16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_18" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl15" target="hl17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_19" value="cryptoKey" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl16" target="hl17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_20" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl17" target="hl18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_21" value="false/完了後" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl17" target="hl19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_22" value="initBuffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl18" target="hl19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_23" value="raw ArrayBuffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl19" target="hl20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl20" target="hl21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl21" target="hl22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_26" value="Blob" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl22" target="hl23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_27" value="downloadId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl23" target="hl24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_28" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl24" target="hl25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_29" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl24" target="hl26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-hls_30" value="filePath" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::HLS" source="hl25" target="hl26"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-dash" name="4.DASH"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1599" pageHeight="3273" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::DASH" value="DASH データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1579" height="3253" as="geometry"/></mxCell><mxCell id="d0" value="画面から「この動画をダウンロードして」とお願いが届く&lt;br&gt;DASH DL要求（popup/panel / 全DL）&lt;br&gt;{url(mpdUrl), pageURL, tabId}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="208" y="50" width="1163" height="136" as="geometry"/></mxCell><mxCell id="d1" value="動画の設計図を取ってき始める&lt;br&gt;DASH情報取得処理（fetchDashInfo(url,pageURL)）&lt;br&gt;fetchDashInfo.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="396" y="216" width="786" height="105" as="geometry"/></mxCell><mxCell id="d2" value="アドレスが、別の種類の配信方式かどうかを調べる&lt;br&gt;MSS形式判定（isMssUrl(url)?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="180" y="351" width="1218" height="133" as="geometry"/></mxCell><mxCell id="d7" value="動画の設計図を取ってきて、中身を読み解く&lt;br&gt;MPD取得・解析処理（fetchTextWithReferer(url) → MPD text）&lt;br&gt;→ parseMpd(text,url)&lt;br&gt;parseMpd.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="307" y="1109" width="965" height="132" as="geometry"/></mxCell><mxCell id="d8" value="設計図を読み解いてわかった、映像と音の情報&lt;br&gt;MPD解析結果&lt;br&gt;{ok,videoReps[],audioReps[],&lt;br&gt; baseURL,mpdDuration}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#b1a100;size=10;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="428" y="1271" width="722" height="132" as="geometry"/></mxCell><mxCell id="d9" value="まとめてダウンロードするとき、映像と音を自動でくっつける&lt;br&gt;自動DASHミックス処理（autoDashMux(item,tabId)）&lt;br&gt;(全DL専用: 既定=最高帯域トラック選択)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="316" y="1433" width="946" height="105" as="geometry"/></mxCell><mxCell id="d10" value="映像と音、両方のデータがあるかを調べる&lt;br&gt;映像・音声トラック有無判定（videoRepとaudioRep両方ある?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="40" y="1568" width="1499" height="133" as="geometry"/></mxCell><mxCell id="d11" value="映像と音を取ってきて、1つのファイルにまとめる&lt;br&gt;DASH結合ダウンロード処理（downloadDashAndMux({videoRep,audioRep,mpdUrl,...})）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="140" y="1731" width="1298" height="78" as="geometry"/></mxCell><mxCell id="d17" value="映像と音を、それぞれ同時に取ってきてまとめる&lt;br&gt;トラック並列取得処理（fetchTrackToBlob）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="412" y="2487" width="754" height="78" as="geometry"/></mxCell><mxCell id="d18" value="取ってきたデータを、お手伝いアプリに送れる形に変える&lt;br&gt;Base64変換処理（blobToBase64(videoBlob/audioBlob)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="348" y="2595" width="882" height="78" as="geometry"/></mxCell><mxCell id="d19" value="お手伝いアプリに「映像と音をくっつけて」とお願いする&lt;br&gt;companionへのmux依頼（sendToCompanion({type:&#x27;mux&#x27;,videoB64,audioB64,outputName})）&lt;br&gt;→ companion連携図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#e6e6e6;" vertex="1" parent="cat::DASH"><mxGeometry x="108" y="2703" width="1362" height="105" as="geometry"/></mxCell><mxCell id="d20" value="お手伝いアプリがくっつけ終えた結果&lt;br&gt;結合結果&lt;br&gt;{ok:true,muxed:true,filePath}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="492" y="2838" width="594" height="105" as="geometry"/></mxCell><mxCell id="d21" value="お手伝いアプリがつながっていないときは、映像と音を別々に保存する&lt;br&gt;個別DLフォールバック処理（downloadDashTrack ×2 にフォールバック）&lt;br&gt;(別ファイルDL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="243" y="2973" width="1093" height="105" as="geometry"/></mxCell><mxCell id="d3" value="別方式のアドレスを、この方式のアドレスに変えられるか確認する&lt;br&gt;MSS→DASH URL解決処理（resolveMssDashUrl(url,pageURL)）&lt;br&gt;(候補を順にfetchし&lt;MPD&gt;を含むか確認)&lt;br&gt;→ MSS図のismToDashCandidatesへ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#ffe6cc;" vertex="1" parent="cat::DASH"><mxGeometry x="284" y="514" width="1010" height="132" as="geometry"/></mxCell><mxCell id="d4" value="この配信方式のアドレスが、見つかったかを調べる&lt;br&gt;DASH URL発見判定（DASH URLが見つかった?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="180" y="676" width="1218" height="133" as="geometry"/></mxCell><mxCell id="d5" value="見つけ出せた、動画の設計図のアドレス&lt;br&gt;解決済みMPD URL（url = dashUrl）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="476" y="839" width="626" height="78" as="geometry"/></mxCell><mxCell id="d12" value="指定された映像か音を、ダウンロードする&lt;br&gt;DASHトラックDL処理（downloadDashTrack({rep,mpdUrl,trackType,...})）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="228" y="1839" width="1122" height="78" as="geometry"/></mxCell><mxCell id="d13" value="部品の型から、実際の部品アドレスの一覧を作る&lt;br&gt;セグメントURL展開処理（expandSegmentUrls(segInfo,...)）&lt;br&gt;→ {initUrl/initBytes, segUrls[]}&lt;br&gt;dashSegments.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="324" y="1947" width="930" height="132" as="geometry"/></mxCell><mxCell id="d14" value="準備データと動画の部品を、同時に取ってくる&lt;br&gt;初期化+セグメント並列取得処理（init+mediaセグメントを並列fetch(4)）&lt;br&gt;→ ArrayBuffer[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="228" y="2109" width="1122" height="105" as="geometry"/></mxCell><mxCell id="d15" value="取ってきたデータをつなげて、映像や音のファイルを組み立てる&lt;br&gt;トラック結合処理（combine → Uint8Array → Blob(mp4/m4a)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="300" y="2244" width="978" height="78" as="geometry"/></mxCell><mxCell id="d16" value="できあがったファイルを、パソコンに保存する&lt;br&gt;ファイル保存処理（browser.downloads.download(blobUrl)）&lt;br&gt;→ downloadId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="324" y="2352" width="930" height="105" as="geometry"/></mxCell><mxCell id="d6" value="別方式の設計図を取ってきて、中身を読み解く&lt;br&gt;ismマニフェスト取得・解析処理（fetchTextWithReferer(元ism url)）&lt;br&gt;→ parseIsmManifest(text,url)&lt;br&gt;→ MSS図へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#ffe6cc;" vertex="1" parent="cat::DASH"><mxGeometry x="252" y="947" width="1074" height="132" as="geometry"/></mxCell><mxCell id="d22" value="一度調べたアドレスの変換結果を、覚えておく場所&lt;br&gt;MSS→DASH URL解決キャッシュ（_mssDashUrlCache）&lt;br&gt;(ismUrl→dashUrl 解決結果)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::DASH"><mxGeometry x="395" y="3108" width="789" height="105" as="geometry"/></mxCell><mxCell id="edf-dash_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::DASH" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-dash_3" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;