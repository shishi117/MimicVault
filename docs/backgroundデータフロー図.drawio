1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::直接DL（mp4分割）" source="r16" target="r17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-direct_19" value="進捗" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::直接DL（mp4分割）" source="r9" target="r18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-direct_20" value="進捗" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::直接DL（mp4分割）" source="r14" target="r18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-live" name="8.ライブ録画"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1599" pageHeight="3080" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::ライブ録画" value="ライブ録画 データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1579" height="3060" as="geometry"/></mxCell><mxCell id="l0" value="調べた結果から、今ライブ配信中だと気づく&lt;br&gt;ライブ配信検出（HLS図: parsed.ended===false）&lt;br&gt;(ライブ配信検出)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#d5e8d4;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="283" y="50" width="1012" height="136" as="geometry"/></mxCell><mxCell id="l1" value="ライブ配信の録画を始める&lt;br&gt;ライブ録画開始処理（startLiveRecording(url,pageURL,parsed,tabId)）&lt;br&gt;liveRecording.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="236" y="216" width="1106" height="105" as="geometry"/></mxCell><mxCell id="l2" value="動画の部品にカギ（暗号）がかかっているか調べる&lt;br&gt;暗号化方式判定（keyInfo.method===&#x27;AES-128&#x27;?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="180" y="351" width="1218" height="133" as="geometry"/></mxCell><mxCell id="l4" value="保存するときのファイル名のもとになる文字を取ってくる&lt;br&gt;ファイル名素材取得処理（inferTitleStem(url,tabId) → stem）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="299" y="649" width="981" height="78" as="geometry"/></mxCell><mxCell id="l5" value="録画の状況を覚えておくための情報を作る&lt;br&gt;録画セッション生成処理&lt;br&gt;session生成&lt;br&gt;{state,url,buffer:[],seenUrls:Set,&lt;br&gt; chunkIndex,totalSegments,...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="460" y="757" width="658" height="159" as="geometry"/></mxCell><mxCell id="l7" value="新しく見つかった部品を、録画データに取り込む&lt;br&gt;新規セグメント処理（processNewSegments(session,parsed)）&lt;br&gt;liveSegments.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="316" y="1081" width="946" height="105" as="geometry"/></mxCell><mxCell id="l8" value="まだ取っていない部品を順番に取ってきて、カギがかかっていれば開ける&lt;br&gt;セグメント取得処理（未取得segmentを順にfetch）&lt;br&gt;→ ArrayBuffer → decryptSegment?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="236" y="1216" width="1106" height="105" as="geometry"/></mxCell><mxCell id="l9" value="取ってきた部品を、一時的にためておく場所に追加する&lt;br&gt;バッファ追加処理（session.buffer[]に追加）&lt;br&gt;totalSegments++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="364" y="1351" width="850" height="105" as="geometry"/></mxCell><mxCell id="l10" value="ためた部品の数が、決めた数に達したか調べる&lt;br&gt;バッファ上限判定（buffer.length &gt;= LIVE_CHUNK_SIZE(30)?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="40" y="1486" width="1499" height="133" as="geometry"/></mxCell><mxCell id="l12" value="録画の進み具合を、画面に知らせる&lt;br&gt;録画進捗通知処理（sendLiveProgress(session)）&lt;br&gt;→ LIVE_RECORDING_PROGRESS → popup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="404" y="1838" width="770" height="105" as="geometry"/></mxCell><mxCell id="l13" value="少し時間をおいて、もう一度配信をチェックする予定を入れる&lt;br&gt;次回ポーリング予約処理（schedulePoll(url)）&lt;br&gt;setTimeout(targetDuration秒)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="316" y="1973" width="946" height="105" as="geometry"/></mxCell><mxCell id="l14" value="ライブ配信の一覧表を、もう一度確認する&lt;br&gt;ライブセッション再確認処理（pollLiveSession(url)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="364" y="2108" width="850" height="78" as="geometry"/></mxCell><mxCell id="l15" value="最新の一覧表を取ってきて、中身を読み解く&lt;br&gt;プレイリスト再取得・解析処理（fetch(url) → text → parseMediaPlaylist）&lt;br&gt;→ parsed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="201" y="2216" width="1176" height="105" as="geometry"/></mxCell><mxCell id="l3" value="カギのかかった部品を開けるための、カギを取ってくる&lt;br&gt;復号鍵取得処理（fetchAesKey(uri,pageURL)）&lt;br&gt;→ cryptoKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="364" y="514" width="850" height="105" as="geometry"/></mxCell><mxCell id="l6" value="今進んでいるライブ録画の情報をためておく場所&lt;br&gt;ライブ録画セッション一覧（liveRecordingSessions）&lt;br&gt;(Map&lt;url, session&gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="372" y="946" width="834" height="105" as="geometry"/></mxCell><mxCell id="l11" value="ためておいた部品を、ファイルとして書き出す&lt;br&gt;バッファ書き出し処理（flushChunk(session)）&lt;br&gt;combine→Uint8Array→Blob(mp2t)&lt;br&gt;→browser.downloads.download&lt;br&gt;(stream_chunkNNN.ts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#f8cecc;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="420" y="1649" width="738" height="159" as="geometry"/></mxCell><mxCell id="l16" value="配信が、もう終わったかどうかを調べる&lt;br&gt;配信終了判定（parsed.ended?）&lt;br&gt;(#EXT-X-ENDLIST検出)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="308" y="2351" width="962" height="179" as="geometry"/></mxCell><mxCell id="l17" value="残っている部品も書き出して、録画を終わりにする&lt;br&gt;録画終了処理（flushChunk(残り)）&lt;br&gt;session.state=&#x27;stopped&#x27;&lt;br&gt;liveRecordingSessions.delete(url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="396" y="2560" width="786" height="132" as="geometry"/></mxCell><mxCell id="l18" value="使っている人が、画面の「止める」ボタンを押した&lt;br&gt;録画停止要求（STOP_LIVE_RECORDING{url}）&lt;br&gt;(popup■停止ボタン)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="272" y="2722" width="1034" height="136" as="geometry"/></mxCell><mxCell id="l19" value="押されたボタンによって、ライブ録画を止める&lt;br&gt;ライブ録画停止処理（stopLiveRecording(url)）&lt;br&gt;clearTimeout(pollTimer) → flushChunk(残り)&lt;br&gt;→ session削除 → sendLiveProgress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ライブ録画"><mxGeometry x="412" y="2888" width="754" height="132" as="geometry"/></mxCell><mxCell id="edf-live_1" value="mediaPlaylistUrl,pageURL,parsed,tabId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l0" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_3" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;htm