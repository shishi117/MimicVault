Color=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="2231" height="2802" as="geometry"/></mxCell><mxCell id="c0" value="起動時や設定変更時にcompanionへの接続を試みる&lt;br&gt;companion接続処理（connectCompanion()）&lt;br&gt;起動時 / settingsCache.companionEnabled変化&lt;br&gt;companion.js" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="267" y="50" width="1697" height="171" as="geometry"/></mxCell><mxCell id="c1" value="companion連携が設定で無効化されているかを判定する&lt;br&gt;companion有効判定（companionEnabled===false?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="40" y="251" width="2151" height="133" as="geometry"/></mxCell><mxCell id="c3" value="ネイティブアプリとしてcompanionに接続する&lt;br&gt;companionネイティブ接続処理&lt;br&gt;browser.runtime.connectNative(&#x27;mimic_vault&#x27;)&lt;br&gt;→ companionPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="331" y="549" width="1568" height="132" as="geometry"/></mxCell><mxCell id="c5" value="各ダウンロード処理からcompanionに変換等を依頼する&lt;br&gt;companionへの処理依頼&lt;br&gt;各DL関数(HLS/DASH/直接DL/収集ストリーム)&lt;br&gt;→ sendToCompanion(command,onProgress)&lt;br&gt;{type:&#x27;convert&#x27;|&#x27;mux&#x27;|&#x27;remux&#x27;|&#x27;concatParts&#x27;,...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="261" y="846" width="1708" height="159" as="geometry"/></mxCell><mxCell id="c6" value="依頼ごとに識別IDを発行し応答待ちとして登録する&lt;br&gt;リクエストID発行処理（requestId発行）&lt;br&gt;companionPendingRequests.set(id,{resolve,reject,onProgress})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="51" y="1035" width="2128" height="105" as="geometry"/></mxCell><mxCell id="c8" value="companionアプリへ依頼内容を送信する&lt;br&gt;companionへのメッセージ送信処理&lt;br&gt;companionPort.postMessage(&lt;br&gt;{...command,requestId})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="646" y="1305" width="938" height="132" as="geometry"/></mxCell><mxCell id="c9" value="変換・結合等を実際に行う外部アプリ&lt;br&gt;companionアプリ（Node.js + FFmpeg, 別プロセス）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="454" y="1467" width="1323" height="78" as="geometry"/></mxCell><mxCell id="c10" value="companionアプリからの応答を受信する&lt;br&gt;companion応答受信処理（companionPort.onMessage(msg)）&lt;br&gt;{requestId, type:&#x27;progress&#x27;|ok:true|ok:false}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="314" y="1575" width="1603" height="105" as="geometry"/></mxCell><mxCell id="c16" value="companionとの接続が切れたことを検知し後始末する&lt;br&gt;companion切断処理（companionPort.onDisconnect）&lt;br&gt;→ companionPort=null&lt;br&gt;status=&#x27;error&#x27;/&#x27;disconnected&#x27;&lt;br&gt;全pendingRequestsをreject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="384" y="2468" width="1463" height="159" as="geometry"/></mxCell><mxCell id="c17" value="companionの接続状態をポップアップへ通知する&lt;br&gt;companion状態通知処理（broadcastCompanionStatus()）&lt;br&gt;→ COMPANION_STATUS → popup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="349" y="2657" width="1533" height="105" as="geometry"/></mxCell><mxCell id="c2" value="companion連携が無効であることを通知する&lt;br&gt;無効状態通知&lt;br&gt;status=&#x27;disabled&#x27; → broadcastCompanionStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="331" y="414" width="1568" height="105" as="geometry"/></mxCell><mxCell id="c4" value="companionとの通信に使うポート&lt;br&gt;companion通信ポート（companionPort）&lt;br&gt;(Native Messagingポート, 変数)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="594" y="711" width="1043" height="105" as="geometry"/></mxCell><mxCell id="c7" value="応答待ちの依頼を管理するストア&lt;br&gt;companion応答待ちリクエスト一覧（companionPendingRequests）&lt;br&gt;(Map&lt;requestId,{resolve,reject,onProgress}&gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="296" y="1170" width="1638" height="105" as="geometry"/></mxCell><mxCell id="c11" value="受信した応答が進捗通知かを判定する&lt;br&gt;進捗通知判定（msg.type===&#x27;progress&#x27;?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="305" y="1710" width="1621" height="133" as="geometry"/></mxCell><mxCell id="c13" value="受信した応答が成功を示しているかを判定する&lt;br&gt;成否判定（msg.ok===true?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="543" y="2008" width="1144" height="133" as="geometry"/></mxCell><mxCell id="c12" value="進捗情報を呼び出し元へ中継する&lt;br&gt;進捗中継処理（req.onProgress(msg)）&lt;br&gt;→ popupへ進捗通知(各図参照)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="629" y="1873" width="973" height="105" as="geometry"/></mxCell><mxCell id="c14" value="成功応答を呼び出し元のPromiseに反映する&lt;br&gt;成功時解決処理（req.resolve(msg)）&lt;br&gt;→ 呼び出し元のPromiseが解決&lt;br&gt;(filePath等)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="664" y="2171" width="903" height="132" as="geometry"/></mxCell><mxCell id="c15" value="失敗応答を呼び出し元のPromiseに反映する&lt;br&gt;失敗時解決処理（req.reject(Error)）&lt;br&gt;→ 呼び出し元のPromiseが失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::companion連携"><mxGeometry x="646" y="2333" width="938" height="105" as="geometry"/></mxCell><mxCell id="edf-companion_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::companion連携" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-companion_2" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::companion連携" source="c1" target="c2"><mxGeometry relative="