<mxfile host="app.diagrams.net"><diagram id="df-routing" name="1.ルーティング／検出"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1676" pageHeight="2898" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::ルーティング／検出エントリ" value="ルーティング／検出エントリ データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1656" height="2878" as="geometry"/></mxCell><mxCell id="area::r_a" value="① サイトで動画・音声を見つける" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=16;fontStyle=1;fontColor=#555555;fontFamily=Meiryo UI;fillColor=#f5f5f5;strokeColor=#aaaaaa;dashed=1;strokeWidth=1;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="20" y="20" width="1616" height="1644" as="geometry"/></mxCell><mxCell id="area::r_b" value="② ダウンロードをお願いされる" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=16;fontStyle=1;fontColor=#555555;fontFamily=Meiryo UI;fillColor=#f5f5f5;strokeColor=#aaaaaa;dashed=1;strokeWidth=1;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="20" y="1714" width="1616" height="605" as="geometry"/></mxCell><mxCell id="area::r_c" value="③ タブが閉じられたときの片づけ" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=16;fontStyle=1;fontColor=#555555;fontFamily=Meiryo UI;fillColor=#f5f5f5;strokeColor=#aaaaaa;dashed=1;strokeWidth=1;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="20" y="2369" width="1616" height="489" as="geometry"/></mxCell><mxCell id="r_a0" value="動画や音声のデータが届いたことに気づく&lt;br&gt;ネットワーク応答開始イベント（browser.webRequest.onResponseStarted）&lt;br&gt;(details: url, tabId, responseHeaders)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="73" y="64" width="1509" height="136" as="geometry"/></mxCell><mxCell id="r_a1" value="届いたデータを、次のチェック係に渡す&lt;br&gt;ネットワーク応答ハンドラ（handleNetworkResponse(details)）&lt;br&gt;webRequest.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="339" y="230" width="978" height="105" as="geometry"/></mxCell><mxCell id="r_a2" value="このサイトがダウンロードしてはいけないサイトかどうかを調べる&lt;br&gt;ドメイン除外判定（isDomainFiltered(url)）?&lt;br&gt;(domainFilter.js)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="40" y="365" width="1576" height="179" as="geometry"/></mxCell><mxCell id="r_a3" value="届いたデータが、動画を細かく分けた一部分かどうかを調べる&lt;br&gt;セグメントURL判定（isSegmentUrl(url)）?&lt;br&gt;(segmentGroups.js)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="91" y="682" width="1474" height="179" as="geometry"/></mxCell><mxCell id="r_a4" value="動画の一部分だとわかったら、場所を記録しておく&lt;br&gt;セグメント記録処理（recordSegment(tabId, url, pageURL)）&lt;br&gt;→ 収集ストリーム図へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#fff2cc;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="355" y="999" width="946" height="105" as="geometry"/></mxCell><mxCell id="r_a5" value="届いたデータの種類や大きさを調べる&lt;br&gt;メディア種別推定処理（getHeader/inferMimeFromUrl/resolveTag）&lt;br&gt;→ {mimeHint, tag, contentLength}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="315" y="1134" width="1026" height="105" as="geometry"/></mxCell><mxCell id="r_a6" value="見つけた動画や音声を、タブごとのリストに保存する&lt;br&gt;メディアストア登録処理（addToStore(tabId, item)）&lt;br&gt;mediaStore.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="411" y="1269" width="834" height="105" as="geometry"/></mxCell><mxCell id="r_a8" value="動画の一覧が増えたことを画面に知らせる&lt;br&gt;メディア一覧更新通知（MEDIA_LIST_UPDATED）&lt;br&gt;→ content script / パネル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="467" y="1539" width="722" height="105" as="geometry"/></mxCell><mxCell id="r_c0" value="タブが閉じられたり、ページが読み込み直されたことに気づく&lt;br&gt;タブ状態変化イベント（browser.tabs.onRemoved / onUpdated(loading)）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="84" y="2413" width="1487" height="101" as="geometry"/></mxCell><mxCell id="r_c1" value="そのタブに保存していた動画の情報を消す&lt;br&gt;タブ別データ破棄処理（tabs.js）&lt;br&gt;delete tabMediaStore[tabId]&lt;br&gt;clearSegmentGroups(tabId)&lt;br&gt;updateBadge(tabId,0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="499" y="2544" width="658" height="159" as="geometry"/></mxCell><mxCell id="r_c2" value="そのタブで録画していたライブ配信を止める&lt;br&gt;ライブ録画停止処理（stopLiveRecording(url)）&lt;br&gt;(別図: ライブ録画)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#cce5ff;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="451" y="2733" width="754" height="105" as="geometry"/></mxCell><mxCell id="r_a7" value="タブごとに見つけた動画や音声をためておく場所&lt;br&gt;タブ別メディア一覧（tabMediaStore）&lt;br&gt;(タブ別 Map&lt;url,item&gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="451" y="1404" width="754" height="105" as="geometry"/></mxCell><mxCell id="r_err1" value="ダウンロードしないサイトだったので、ここで終わる&lt;br&gt;除外・処理なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="419" y="574" width="818" height="78" as="geometry"/></mxCell><mxCell id="r_err2" value="動画の一部分ではなかったので、ここで終わる&lt;br&gt;除外・処理なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="467" y="891" width="722" height="78" as="geometry"/></mxCell><mxCell id="r_b0" value="画面のボタンから「ダウンロードして」とお願いが届く&lt;br&gt;ダウンロード要求送信（panel/popup → runtime.sendMessage）&lt;br&gt;{type:&#x27;DOWNLOAD_...&#x27;, url, pageURL, tabId, ...}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="190" y="1758" width="1276" height="136" as="geometry"/></mxCell><mxCell id="r_b1" value="届いたお願いの内容によって、担当する処理を振り分ける&lt;br&gt;メッセージルーター（messageRouter.js）&lt;br&gt;(onMessage: message.type で分岐)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="387" y="1924" width="882" height="105" as="geometry"/></mxCell><mxCell id="r_b2" value="動画の種類に合わせて、ダウンロード係を呼び出す&lt;br&gt;ダウンローダー呼び出し（DOWNLOADERS[type](item, tabId)）&lt;br&gt;DOWNLOAD_MEDIA_ALL / downloaders.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="355" y="2059" width="946" height="105" as="geometry"/></mxCell><mxCell id="r_b3" value="配信の方式ごとに、それぞれの担当処理にまかせる&lt;br&gt;方式別処理への委譲&lt;br&gt;(HLS / DASH / 収集ストリーム / 直接DL 各図)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ルーティング／検出エントリ"><mxGeometry x="435" y="2194" width="786" height="105" as="geometry"/></mxCell><mxCell id="edf-routing_1" value="details" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ルーティング／検出エントリ" source="r_a0" target="r_a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-routing_2" value="url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ルーティング／検出エントリ" source="r_a1" target="r_a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-routing_3" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ルーティング／検出エントリ" source="r_a2" target="r_err1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-routing_4" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e