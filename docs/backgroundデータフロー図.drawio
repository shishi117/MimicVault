p=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l15" target="l16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_19" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l16" target="l17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_20" value="false(継続)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l16" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_21" value="false(次ポーリング)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l16" target="l13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_22" value="url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l18" target="l19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-live_23" value="session削除" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ライブ録画" source="l19" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="df-bookmark" name="9.ブックマーク一括DL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1436" pageHeight="3238" math="0" shadow="0" defaultFontFamily="Meiryo UI"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat::ブックマーク一括DL" value="ブックマーク一括DL データフロー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;strokeColor=#555555;strokeWidth=2;fontColor=#222222;fontFamily=Meiryo UI;fillColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1416" height="3218" as="geometry"/></mxCell><mxCell id="b0" value="選んだブックマークを、まとめてダウンロードしたいというお願い&lt;br&gt;一括DL要求（DOWNLOAD_BOOKMARKS{ids[]}）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="40" y="50" width="1336" height="101" as="geometry"/></mxCell><mxCell id="b1" value="指定されたブックマークのダウンロードを、まとめて始める&lt;br&gt;ブックマーク一括DL処理（downloadBookmarks(ids)）&lt;br&gt;bookmarkDownload.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="251" y="181" width="914" height="105" as="geometry"/></mxCell><mxCell id="b2" value="ブックマークの番号から、くわしい情報を取ってくる&lt;br&gt;ブックマーク情報取得処理（browser.bookmarks.get(id) → node）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="201" y="316" width="1013" height="78" as="geometry"/></mxCell><mxCell id="b3" value="ブックマーク1つ分の処理を行う&lt;br&gt;ブックマーク単体処理（processOneBookmark(node)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="299" y="424" width="818" height="78" as="geometry"/></mxCell><mxCell id="b4" value="ブックマークしたページを、見えないタブでこっそり開く&lt;br&gt;裏タブでのページ表示処理（browser.tabs.create(node.url,active:false)）&lt;br&gt;→ tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="123" y="532" width="1170" height="105" as="geometry"/></mxCell><mxCell id="b5" value="ページが読み込み終わるのを待つ&lt;br&gt;タブ読み込み完了待ち処理（waitTabComplete(tab.id)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="275" y="667" width="866" height="78" as="geometry"/></mxCell><mxCell id="b6" value="自動で再生されない動画を、再生させる操作をする&lt;br&gt;自動再生ナッジ処理（nudgePlay(tabId)）&lt;br&gt;executeScript(自動再生ナッジ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="315" y="775" width="786" height="105" as="geometry"/></mxCell><mxCell id="b7" value="動画や音声が見つかるまで待つ&lt;br&gt;メディア検出待ち処理（waitForMedia(tabId)）&lt;br&gt;ポーリング→getStore(tabId)参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="339" y="910" width="738" height="105" as="geometry"/></mxCell><mxCell id="b9" value="見つかった動画の中から、ダウンロードするものを選ぶ&lt;br&gt;メディア選択処理（pickMediaItem(items)）&lt;br&gt;(ストリーミング優先→サイズ最大)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="283" y="1180" width="850" height="105" as="geometry"/></mxCell><mxCell id="b10" value="ダウンロードする動画が、見つかったかを調べる&lt;br&gt;メディア発見判定（item見つかった?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="125" y="1315" width="1166" height="133" as="geometry"/></mxCell><mxCell id="b12" value="ブックマークの題名から、保存するファイル名を決める&lt;br&gt;ファイル名上書き値生成処理&lt;br&gt;stemOverride = bookmarkFilenameStem(タイトル)&lt;br&gt;(getPageTitle併用)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="283" y="1613" width="850" height="132" as="geometry"/></mxCell><mxCell id="b13" value="見つけた動画のダウンロードを実行する&lt;br&gt;検出メディアDL処理（downloadDetected(item,emit,stemOverride)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="187" y="1775" width="1042" height="78" as="geometry"/></mxCell><mxCell id="b14" value="見つけた動画が、細切れ配信の仲間かどうかを調べる&lt;br&gt;配信方式判定（isHls/isDash?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="73" y="1883" width="1269" height="133" as="geometry"/></mxCell><mxCell id="b16" value="そのままのファイルなら、そのままダウンロードする&lt;br&gt;直接ファイルDL処理&lt;br&gt;browser.downloads.download(url,filename)&lt;br&gt;→ pollRowProgress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="299" y="2181" width="818" height="132" as="geometry"/></mxCell><mxCell id="b17" value="ダウンロードが終わるまで、何度も確認しながら待つ&lt;br&gt;ダウンロード完了待ち処理（gateDownloadResult）&lt;br&gt;(awaitDownloadComplete)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="299" y="2343" width="818" height="105" as="geometry"/></mxCell><mxCell id="b18" value="ダウンロードがうまくいったかを調べる&lt;br&gt;成否判定（dlResult.ok?）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9e8a2e;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="227" y="2478" width="962" height="133" as="geometry"/></mxCell><mxCell id="b21" value="開いていたこっそりタブを閉じて、結果をまとめる&lt;br&gt;タブクローズ・結果集約処理（tab.remove(tab.id)）&lt;br&gt;→ results[]へ集約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#36393d;fontStyle=1;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="299" y="2911" width="818" height="105" as="geometry"/></mxCell><mxCell id="b8" value="タブごとに見つけた動画や音声をためておく場所&lt;br&gt;タブ別メディア一覧（tabMediaStore）&lt;br&gt;(判定・共通ヘルパー図と共通)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="331" y="1045" width="754" height="105" as="geometry"/></mxCell><mxCell id="b11" value="動画が見つからなかったことを知らせる&lt;br&gt;失敗通知処理（emit(&#x27;failed&#x27;,{reason:&#x27;no_media&#x27;})）&lt;br&gt;→ bookmarkProgressState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="283" y="1478" width="850" height="105" as="geometry"/></mxCell><mxCell id="b15" value="細切れ配信の仲間なら、それぞれの専門処理にまかせる&lt;br&gt;方式別DLへの委譲（downloadHlsSegments / autoDashMux）&lt;br&gt;→ HLS図/DASH図へ委譲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;fillColor=#d5e8d4;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="259" y="2046" width="898" height="105" as="geometry"/></mxCell><mxCell id="b19" value="ダウンロードが終わったら、ブックマークを完了フォルダに移す&lt;br&gt;完了フォルダ移動処理（ensureDownloadedFolder(node.parentId)）&lt;br&gt;→ bookmarks.move(bookmarkId,parentId)&lt;br&gt;emit(&#x27;done&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="195" y="2641" width="1026" height="132" as="geometry"/></mxCell><mxCell id="b20" value="ダウンロードに失敗したことを知らせる&lt;br&gt;失敗通知処理（emit(&#x27;failed&#x27;,{reason})）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="371" y="2803" width="674" height="78" as="geometry"/></mxCell><mxCell id="b22" value="それぞれのブックマークの進み具合をためておく場所&lt;br&gt;ブックマークDL進捗状態（bookmarkProgressState）&lt;br&gt;(Map&lt;bookmarkId,{state,...}&gt;)&lt;br&gt;→ BOOKMARK_DL_PROGRESS → popup" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fbe3d6;strokeColor=#b46504;fontColor=#222222;fontFamily=Meiryo UI;fontSize=18;" vertex="1" parent="cat::ブックマーク一括DL"><mxGeometry x="299" y="3046" width="818" height="132" as="geometry"/></mxCell><mxCell id="edf-bookmark_1" value="ids[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_2" value="id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_3" value="node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_4" value="node.url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_5" value="tab.id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edf-bookmark_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b7a9e;strokeWidth=1;opacity=80;endArrow=block;endFill=1;startArrow=none;jettySize=8;orthogonalLoop=1;fontColor=#222222;fontFamily=Meiryo UI;labelBackgroundColor=#ffffff;fontSize=18;" edge="1" parent="cat::ブックマーク一括DL" source="b6" target